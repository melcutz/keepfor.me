    "spec_writer": "gemini-4-hydrogen-medium",
    "builder": "gemini-4-hydrogen-medium",
    "approver": "gemini-4-argon-medium",
    "qa": "gemini-4-hydrogen-medium",
    "code_low": "gemini-4-hydrogen-low",
    "code_medium": "gemini-4-hydrogen-low",
    "code_high": "gemini-4-hydrogen-medium",
    "security": "gemini-4-argon-medium",
